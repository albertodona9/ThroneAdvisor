{
  "name": "throneadvisor",
  "version": "0.1.0",
  "private": true,
  "description": "Find and rate the toilets on campus.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertodona9/ThroneAdvisor.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only firestore,auth",
    "test:rules": "firebase emulators:exec --only firestore --project demo-throneadvisor-rules \"vitest run\"",
    "toilets:fetch": "node scripts/fetch-toilets.mjs",
    "seed": "node scripts/seed-emulator.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
