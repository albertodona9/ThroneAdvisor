# Used by `npm run dev`. Talks to the local Firebase emulators (npm run emulators), never to
# a real project, so these values are fake placeholders and safe to commit.
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-emulator-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=throneadvisor-0
VITE_FIREBASE_APP_ID=demo-emulator-app

# To point `npm run dev` at a real project instead, override these in .env.development.local
# (git-ignored): VITE_USE_EMULATOR=false plus the real values from .env.example.
