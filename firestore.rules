rules_version = '2';

// ThroneAdvisor data model (one set of documents per campus):
//
//   campuses/{campus}/meta/stats                      one doc with every toilet's score sums
//   campuses/{campus}/meta/live                       one doc with every toilet currently in use
//   campuses/{campus}/toilets/{id}/reviews/{uid}      one review per user per toilet
//   campuses/{campus}/toilets/{id}/reviews/{uid}/likes/{liker}   one like (see below)
//   campuses/{campus}/royals/{uid}                    public leaderboard record of a king / queen (all time)
//   campuses/{campus}/weeks/{week}/royals/{uid}       the same, for one week (a new week = a fresh board)
//   users/{uid}                                       a user's private profile (see below)
//
// The map needs every toilet's score, so those live in ONE document: opening the app
// costs a single read no matter how many toilets exist. There are no Cloud Functions,
// so clients maintain the aggregates themselves and these rules make sure that every
// change to an aggregate is backed by a matching review / check-in written in the same
// batch. A client can never write an arbitrary score.
//
// The "in use" (live) document is optional: nobody has to check in. Visits are counted
// when a user leaves a toilet they checked in to, or when they post a review and tick
// "I used this toilet". The live document exists for a future live-availability feature.
//
// Aggregate writes carry two hint fields: `ref` (the toilet id being changed) and `at`
// (must equal request.time, which proves the other documents were written in the same
// batch). Rules cannot iterate over map keys, hence the hint.

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared by the campus rules and the profile rules below.
    function signedIn() {
      return request.auth != null;
    }
    match /campuses/{campus} {

      // ---- helpers ---------------------------------------------------------

      function statsPath() {
        return /databases/$(database)/documents/campuses/$(campus)/meta/stats;
      }
      function livePath() {
        return /databases/$(database)/documents/campuses/$(campus)/meta/live;
      }
      function reviewPath(id, uid) {
        return /databases/$(database)/documents/campuses/$(campus)/toilets/$(id)/reviews/$(uid);
      }
      function userPath(uid) {
        return /databases/$(database)/documents/users/$(uid);
      }

      function isToiletId(id) {
        return id is string && id.matches('^[0-9]{1,12}$');
      }
      function isScore(v) {
        return v is int && v >= 1 && v <= 10;
      }

      // ---- stats: { t: { <id>: {n, p, c, k, v} }, ref, at } ----------------
      // n = reviews, p/c/k = sums of privacy/cleanliness/comfort scores, v = visits

      match /meta/stats {
        allow get: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['t'])
          && request.resource.data.t.size() == 0;
        allow update: if signedIn() && validStatsUpdate();
      }

      function validStatsUpdate() {
        let d = request.resource.data;
        let id = d.get('ref', '');
        let zero = {'n': 0, 'p': 0, 'c': 0, 'k': 0, 'v': 0};
        let b = resource.data.t.get(id, zero);
        return isToiletId(id)
          && d.keys().hasOnly(['t', 'ref', 'at'])
          && d.at == request.time
          && d.t.diff(resource.data.t).affectedKeys().hasOnly([id])
          && d.t[id].keys().hasOnly(['n', 'p', 'c', 'k', 'v'])
          && d.t[id].n is int && d.t[id].p is int && d.t[id].c is int
          && d.t[id].k is int && d.t[id].v is int
          && (reviewBacksStats(id, b, d.t[id]) || visitBacksStats(id, b, d.t[id]) || quickBacksStats(id, b, d.t[id]));
      }

      // "I just throned": a quick visit with no review and no check-in. It is limited to 3 a day
      // per user, which is tracked in the user's own profile (`q: {d: day, n: count}`) and must be
      // bumped in this same batch, so every counted visit uses up one of the day's three.
      function quickBacksStats(id, b, a) {
        let uid = request.auth.uid;
        let before = exists(userPath(uid)) ? get(userPath(uid)).data : {};
        let after = getAfter(userPath(uid)).data;
        let today = dayNumber(request.time);
        let used = ('q' in before && before.q.d == today) ? before.q.n : 0;
        return a.v == b.v + 1
          && a.n == b.n && a.p == b.p && a.c == b.c && a.k == b.k
          && 'q' in after
          && after.q.d == today
          && after.q.n == used + 1
          && after.q.n <= 3;
      }

      // The user's review doc in this same batch accounts for the exact change.
      // Posting a NEW review may also count as one visit ("I used this toilet"); editing it later can't, so it can't be farmed.
      function reviewBacksStats(id, b, a) {
        let path = reviewPath(id, request.auth.uid);
        let had = exists(path);
        let old = had ? get(path).data : {'p': 0, 'c': 0, 'k': 0};
        let r = getAfter(path).data;
        return r.updatedAt == request.time
          && (a.v == b.v || (a.v == b.v + 1 && !had)) // only a NEW review can also count a visit, not a later edit
          && a.n == b.n + (had ? 0 : 1)
          && a.p == b.p + r.p - old.p
          && a.c == b.c + r.c - old.c
          && a.k == b.k + r.k - old.k;
      }

      // The user was checked in to this toilet, and the same batch checks them out.
      function visitBacksStats(id, b, a) {
        let occ = get(livePath()).data.occ;
        let liveAfter = getAfter(livePath()).data;
        return a.v == b.v + 1
          && a.n == b.n && a.p == b.p && a.c == b.c && a.k == b.k
          && id in occ
          && occ[id].u == request.auth.uid
          && request.time > occ[id].s + duration.value(20, 's')
          && !(id in liveAfter.occ)
          && liveAfter.at == request.time;
      }

      // ---- live: { occ: { <id>: {u, s, d} }, ref, at } ---------------------
      // u = user, s = check-in time (server), d = minutes before it auto-expires

      match /meta/live {
        allow get: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['occ'])
          && request.resource.data.occ.size() == 0;
        allow update: if signedIn() && validLiveUpdate();
      }

      function isExpired(o) {
        return request.time > o.s + duration.value(o.d, 'm');
      }
      function validOccupancy(o) {
        return o.keys().hasOnly(['u', 's', 'd'])
          && o.u == request.auth.uid
          && o.s == request.time
          && o.d is int && o.d >= 1 && o.d <= 20;
      }

      function validLiveUpdate() {
        let d = request.resource.data;
        let id = d.get('ref', '');
        let before = resource.data.occ;
        return isToiletId(id)
          && d.keys().hasOnly(['occ', 'ref', 'at'])
          && d.at == request.time
          && d.occ.diff(before).affectedKeys().hasOnly([id])
          && (
            // check out: remove your own entry
            (!(id in d.occ) && id in before && before[id].u == request.auth.uid)
            // check in: toilet is free, expired, or already yours
            || (id in d.occ && validOccupancy(d.occ[id])
                && (!(id in before) || before[id].u == request.auth.uid || isExpired(before[id])))
          );
      }

      // ---- reviews ---------------------------------------------------------

      match /toilets/{id}/reviews/{uid} {
        allow get: if true;
        // Page size is capped so nobody can scan the collection for a bill.
        allow list: if request.query.limit <= 25;
        allow create: if signedIn() && request.auth.uid == uid && isToiletId(id)
          && validReview(request.resource.data)
          && request.resource.data.get('lk', 0) == 0
          && request.resource.data.createdAt == request.time
          && statsTouched(id);
        allow update: if signedIn() && (
          // the author editing their review. The like counter is never theirs to change.
          (request.auth.uid == uid
            && request.resource.data.get('lk', 0) == resource.data.get('lk', 0)
            && (
              // changing the scores / text: must come with the matching stats change
              (validReview(request.resource.data)
                && request.resource.data.createdAt == resource.data.createdAt
                && statsTouched(id))
              // changing only the displayed name / avatar (a profile rename): no stats involved
              || validRename(request.resource.data)
            ))
          // somebody else liking / un-liking it
          || validLike(id, uid)
        );
        allow delete: if false;
      }

      // ---- likes: one small document per (review, liker) ---------------------------------
      // The review carries a counter `lk`. It can only move by +1 together with the creation of
      // the liker's own like document in the same batch, and by -1 together with its deletion, and a
      // second like by the same person is just another write to an existing document, which is refused.
      match /toilets/{id}/reviews/{author}/likes/{liker} {
        allow create: if signedIn() && request.auth.uid == liker && liker != author && isToiletId(id)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && likeCountMoves(id, author, 1);
        allow delete: if signedIn() && request.auth.uid == liker && resource != null
          && likeCountMoves(id, author, -1);
      }

      function likePath(id, author, liker) {
        return /databases/$(database)/documents/campuses/$(campus)/toilets/$(id)/reviews/$(author)/likes/$(liker);
      }

      function likeCountMoves(id, author, delta) {
        let p = reviewPath(id, author);
        return exists(p)
          && getAfter(p).data.get('lk', 0) == get(p).data.get('lk', 0) + delta
          && getAfter(p).data.get('lk', 0) >= 0;
      }

      // A non-author update of someone's review: only the counter changes, by exactly one, and it is
      // backed by the liker's own like document appearing (+1) or disappearing (-1) in this batch.
      function validLike(id, author) {
        let d = request.resource.data;
        let old = resource.data;
        let delta = d.get('lk', 0) - old.get('lk', 0);
        let lp = likePath(id, author, request.auth.uid);
        return request.auth.uid != author
          && d.diff(old).affectedKeys().hasOnly(['lk'])
          && d.get('lk', 0) >= 0
          && ((delta == 1 && !exists(lp) && existsAfter(lp))
              || (delta == -1 && exists(lp) && !existsAfter(lp)));
      }

      // ---- royals: the public leaderboard record of each king / queen ---------------------
      // campuses/{campus}/royals/{uid} = {name, emoji?, title?, born, n, ts?, x?}. n is the number of throning
      // sessions: it can only grow by exactly one, and only in a batch that also counted one visit
      // (which the stats rules verify), so it can't be set to an arbitrary number.
      match /royals/{uid} {
        allow get: if true;
        allow list: if request.query.limit <= 50;
        allow create: if signedIn() && request.auth.uid == uid
          && validRoyal(request.resource.data)
          && request.resource.data.n == 1
          && visitBumped()
          && triedOk(request.resource.data, {});
        allow update: if signedIn() && request.auth.uid == uid
          && validRoyal(request.resource.data)
          && request.resource.data.born == resource.data.born
          && (
            // only the public identity changed (name / avatar / title): the counters stay as they are
            (request.resource.data.n == resource.data.n && countersUnchanged(request.resource.data, resource.data))
            // one more counted visit: one more session, and possibly one more toilet tried
            || (request.resource.data.n == resource.data.n + 1 && visitBumped()
                && triedOk(request.resource.data, resource.data))
          );
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // ---- weekly royals: campuses/{campus}/weeks/{week}/royals/{uid} = {name, emoji?, title?, n} ----
      // The same record per ISO-style week (Monday to Sunday, Denmark time), so "resetting" the weekly
      // leaderboard needs no scheduled job: a new week is simply a new, empty collection. {week} is
      // weekNumber() of the current time, which the rules compute themselves, so a client can only ever
      // write into the running week; past weeks are frozen. `n` moves by +1 together with one counted
      // visit, exactly like the all-time record above.
      match /weeks/{week}/royals/{uid} {
        allow get: if true;
        allow list: if request.query.limit <= 50;
        allow create: if signedIn() && request.auth.uid == uid
          && isCurrentWeek(week)
          && validWeekly(request.resource.data)
          && sameBorn(uid, request.resource.data)
          && request.resource.data.n == 1
          && visitBumped()
          && triedOk(request.resource.data, {});
        allow update: if signedIn() && request.auth.uid == uid
          && isCurrentWeek(week)
          && validWeekly(request.resource.data)
          && sameBorn(uid, request.resource.data)
          && request.resource.data.born == resource.data.born
          && (
            (request.resource.data.n == resource.data.n && countersUnchanged(request.resource.data, resource.data))
            || (request.resource.data.n == resource.data.n + 1 && visitBumped()
                && triedOk(request.resource.data, resource.data))
          );
        allow delete: if false;
      }

      function isCurrentWeek(week) {
        return week.matches('^[0-9]{1,6}$') && int(week) == weekNumber(request.time);
      }

      function validWeekly(r) {
        return r.keys().hasOnly(['name', 'emoji', 'title', 'born', 'n', 'ts', 'x'])
          && r.keys().hasAll(['name', 'born', 'n'])
          && validIdentity(r)
          && r.born is timestamp && r.born <= request.time && r.born > timestamp.date(2024, 1, 1)
          && r.n is int && r.n >= 1
          && validTried(r);
      }

      // The weekly entry shows the same birth date as the all-time record (it breaks weekly ties: the oldest
      // royal wins), so it can't be a different, older one made up for the week.
      function sameBorn(uid, r) {
        return r.born == getAfter(royalPath(uid)).data.born;
      }

      function royalPath(uid) {
        return /databases/$(database)/documents/campuses/$(campus)/royals/$(uid);
      }

      // ---- "Throne Hoppers": how many different toilets a royal has tried -----------------
      // `ts` is the set of toilets they have a counted session at, `x` its size (the number the board is
      // ranked by). A toilet can only enter the set through a counted visit to exactly that toilet (the `ref`
      // of this batch's stats change), once, and nothing ever leaves it, so x can't be set to a number of
      // anyone's choosing. A visit to a toilet already in the set leaves both as they were. Records written
      // before this existed have no ts/x at all, which counts as an empty set.
      function validTried(r) {
        return (!('ts' in r) || (r.ts is map && r.ts.size() <= 1000))
          && (!('x' in r) || (r.x is int && r.x >= 0));
      }

      function countersUnchanged(r, old) {
        return r.get('ts', {}) == old.get('ts', {}) && r.get('x', 0) == old.get('x', 0);
      }

      function triedOk(r, old) {
        let ref = getAfter(statsPath()).data.ref;
        let oldTs = old.get('ts', {});
        let oldX = old.get('x', 0);
        let ts = r.get('ts', {});
        let x = r.get('x', 0);
        return ts.size() <= 1000 && x == ts.size()
          && ((ts == oldTs && x == oldX)
              || (!(ref in oldTs) && ts.diff(oldTs).affectedKeys().hasOnly([ref])
                  && ref in ts && ts[ref] == true && x == oldX + 1));
      }

      // The public name is either a chosen username (3-20) or a generated nickname (up to 30).
      function validIdentity(r) {
        return r.name is string
          && r.name.matches('^[\\p{L}\\p{N}][\\p{L}\\p{N} _.-]{1,28}[\\p{L}\\p{N}]$')
          && (!('emoji' in r) || allowedEmoji(r.emoji))
          && (!('title' in r) || r.title in ['king', 'queen']);
      }

      function validRoyal(r) {
        return r.keys().hasOnly(['name', 'emoji', 'title', 'born', 'n', 'ts', 'x'])
          && r.keys().hasAll(['name', 'born', 'n'])
          && validIdentity(r)
          && r.born is timestamp && r.born <= request.time && r.born > timestamp.date(2024, 1, 1)
          && r.n is int && r.n >= 1
          && validTried(r);
      }

      // This same batch counted exactly one visit on one toilet in the campus stats.
      function visitBumped() {
        let after = getAfter(statsPath()).data;
        let before = get(statsPath()).data;
        return after.at == request.time
          && after.t[after.ref].v == before.t.get(after.ref, {'v': 0}).v + 1;
      }

      function validReview(r) {
        return r.keys().hasOnly(['p', 'c', 'k', 'text', 'by', 'em', 'lk', 'createdAt', 'updatedAt'])
          && (!('lk' in r) || (r.lk is int && r.lk >= 0))
          && r.keys().hasAll(['p', 'c', 'k', 'createdAt', 'updatedAt'])
          && isScore(r.p) && isScore(r.c) && isScore(r.k)
          && r.updatedAt == request.time
          && (!('text' in r) || (r.text is string && r.text.size() >= 1 && r.text.size() <= 280))
          && validDisplay(r);
      }

      // Only `by` / `em` differ from what is stored, and they are valid.
      function validRename(r) {
        return r.diff(resource.data).affectedKeys().hasOnly(['by', 'em']) && validDisplay(r);
      }

      function statsTouched(id) {
        let s = getAfter(statsPath()).data;
        return s.at == request.time && s.ref == id;
      }
    }

    // ---- profiles: users/{uid} -------------------------------------------------
    // Private to their owner (nobody else can read it). It holds the chosen username and
    // avatar plus the owner's own history: `rv` {toiletId: {p, c, k, at}} (my reviews) and
    // `vs` {toiletId: count} (my visits). Only the username/avatar ever become public, and
    // only by being copied onto the owner's review documents, where they are validated too.
    // `rv`/`vs` are the owner's own bookkeeping: bounded in size, not trusted by anyone else.

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data) && quotaOk(request.resource.data, null);
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data) && quotaOk(request.resource.data, resource.data.get('q', null));
      // Deleting your profile is fine, except that it must not be a way to reset today's allowance.
      allow delete: if signedIn() && request.auth.uid == uid
        && (!('q' in resource.data) || resource.data.q.d != dayNumber(request.time));
    }

    // "Day" for the quick-visit allowance: UTC shifted by one hour, so it rolls over at about
    // midnight in Denmark (00:00 in winter, 01:00 in summer). Keep in sync with src/profile.js.
    function dayNumber(t) {
      let s = t + duration.value(1, 'h');
      return s.year() * 10000 + s.month() * 100 + s.day();
    }

    // Number of the leaderboard week containing `t`: whole weeks since Monday 1970-01-05, in the same
    // shifted clock as dayNumber(), so a week starts at about Monday midnight in Denmark.
    // (4 days = 345600000 ms puts the Monday boundary right; 604800000 ms = 7 days.)
    // Keep in sync with weekNumber() in src/profile.js.
    function weekNumber(t) {
      return math.floor((t.toMillis() + 3600000 - 345600000) / 604800000);
    }

    // q = today's quick-visit allowance {d: day, n: used}. It may only stay as it is or move
    // forward on the current day, so it can't be reset by rewriting the document.
    function quotaOk(p, old) {
      let today = dayNumber(request.time);
      return !('q' in p)
        ? old == null
        : (p.q.keys().hasOnly(['d', 'n']) && p.q.d is int && p.q.n is int && p.q.n >= 0 && p.q.n <= 3
            && ((old != null && p.q == old)
                || (p.q.d == today && (old == null || old.d != today || p.q.n >= old.n))));
    }

    function validProfile(p) {
      return p.keys().hasOnly(['name', 'emoji', 'title', 'rv', 'vs', 'q', 'lk'])
        && (!('title' in p) || p.title in ['king', 'queen'])
        && (!('lk' in p) || (p.lk is map && p.lk.size() <= 2000))
        && (!('name' in p) || validName(p.name))
        && (!('emoji' in p) || allowedEmoji(p.emoji))
        && (!('rv' in p) || (p.rv is map && p.rv.size() <= 2000))
        && (!('vs' in p) || (p.vs is map && p.vs.size() <= 2000));
    }

    // Shown to other people (on reviews), so it is constrained: 3-20 letters, digits, spaces, _ . -
    // starting and ending with a letter or digit.
    function validName(n) {
      return n is string && n.matches('^[\\p{L}\\p{N}][\\p{L}\\p{N} _.-]{1,18}[\\p{L}\\p{N}]$');
    }
    function allowedEmoji(e) {
      return e in ['🚽', '👑', '🧻', '🦆', '🐢', '🦉', '🐙', '🦄', '🌵', '🍕', '🎩', '🦊', '🐸', '☕', '🚀', '🦔'];
    }
    // The optional public name/avatar carried by a review.
    function validDisplay(r) {
      return (!('by' in r) || validName(r.by)) && (!('em' in r) || allowedEmoji(r.em));
    }
  }
}
